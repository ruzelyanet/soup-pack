{
  "kind": "collectionType",
  "collectionName": "home_sections",
  "info": { "singularName": "home-section", "pluralName": "home-sections", "displayName": "Секция главной" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title":    { "type": "string", "required": true },
    "slug":     { "type": "uid", "targetField": "title" },
    "icon":     { "type": "string" },
    "sort":     { "type": "integer", "default": 0 },
    "visible":  { "type": "boolean", "default": true },
    "isHits":   { "type": "boolean", "default": false },
    "isSets":   { "type": "boolean", "default": false },
    "category": { "type": "relation", "relation": "manyToOne", "target": "api::category.category" },
    "products": { "type": "relation", "relation": "manyToMany", "target": "api::product.product" }
  }
}
