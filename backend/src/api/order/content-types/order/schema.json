{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": { "singularName": "order", "pluralName": "orders", "displayName": "Заказ" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "code":          { "type": "string", "unique": true },
    "status":        { "type": "enumeration", "enum": ["new", "accepted", "in_progress", "done", "canceled"], "default": "new" },
    "cancelReason":  { "type": "string" },
    "paymentMethod":        { "type": "enumeration", "enum": ["cash", "card", "click", "payme", "transfer"], "default": "card" },
    "deliveryMethod":       { "type": "enumeration", "enum": ["courier_now", "preorder"], "default": "courier_now" },
    "deliverySlotAt":       { "type": "datetime" },
    "comment":              { "type": "text" },
    "subtotal":             { "type": "decimal" },
    "cartDiscountPercent":  { "type": "integer" },
    "cartDiscountAmount":   { "type": "decimal" },
    "discountTotal":        { "type": "integer", "default": 0 },
    "total":                { "type": "decimal", "required": true },
    "items":                { "type": "component", "repeatable": true, "component": "order.line" },
    "address":              { "type": "string" },
    "lat":                  { "type": "decimal" },
    "lng":                  { "type": "decimal" },
    "source":        { "type": "enumeration", "enum": ["catalog", "request", "manual", "telegram"], "default": "catalog", "required": true },
    "paidAmount":    { "type": "integer", "default": 0 },
    "paymentStatus": { "type": "enumeration", "enum": ["unpaid", "partial", "paid", "overpaid", "refunded"], "default": "unpaid" },

    "client":        { "type": "relation", "relation": "manyToOne", "target": "api::client.client", "inversedBy": "orders" },
    "employee":      { "type": "relation", "relation": "manyToOne", "target": "api::employee.employee", "inversedBy": "orders" },
    "createdByEmployee": { "type": "relation", "relation": "manyToOne", "target": "api::employee.employee" },
    "request":       { "type": "relation", "relation": "oneToOne", "target": "api::request.request", "inversedBy": "order" },
    "transactions":  { "type": "relation", "relation": "oneToMany", "target": "api::transaction.transaction", "mappedBy": "order" },
    "events":        { "type": "relation", "relation": "oneToMany", "target": "api::order-event.order-event", "mappedBy": "order" }
  }
}
