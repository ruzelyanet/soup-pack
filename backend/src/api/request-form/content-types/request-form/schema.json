{
  "kind": "collectionType",
  "collectionName": "request_forms",
  "info": { "singularName": "request-form", "pluralName": "request-forms", "displayName": "Форма заявок" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name":           { "type": "string", "required": true },
    "slug":           { "type": "uid", "targetField": "name", "required": true },
    "type":           { "type": "enumeration", "enum": ["individual", "shop"], "default": "individual", "required": true },
    "isActive":       { "type": "boolean", "default": true },
    "title":          { "type": "string" },
    "description":    { "type": "text" },
    "fields":         { "type": "json" },
    "successMessage": { "type": "text" },
    "apiKey":         { "type": "string", "private": true },
    "apiKeyHashed":   { "type": "boolean", "default": false, "private": true },
    "requireApiKey":  { "type": "boolean", "default": false },
    "sourceDetail":   { "type": "string" }
  }
}
