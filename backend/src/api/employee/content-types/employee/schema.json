{
  "kind": "collectionType",
  "collectionName": "employees",
  "info": { "singularName": "employee", "pluralName": "employees", "displayName": "Сотрудник" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "fullName":    { "type": "string", "required": true },
    "phone":       { "type": "string", "required": true, "unique": true },
    "role":        { "type": "enumeration", "enum": ["manager", "duty", "courier"], "default": "courier" },
    "personalKey": { "type": "string", "required": true, "unique": true },
    "dutyFrom":    { "type": "datetime" },
    "dutyTo":      { "type": "datetime" },
    "orders":      { "type": "relation", "relation": "oneToMany", "target": "api::order.order", "mappedBy": "employee" }
  }
}
